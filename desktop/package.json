{
  "name": "careercopilot-desktop",
  "version": "1.0.0",
  "description": "Electron desktop shell wrapper for CareerCopilot",
  "main": "main.js",
  "scripts": {
    "electron": "electron .",
    "dist": "electron-builder --win",
    "postdist": "powershell -Command \"New-Item -ItemType Directory -Force -Path ../server/public/downloads; Copy-Item release/CareerCopilotSetup.exe -Destination ../server/public/downloads/CareerCopilotSetup.exe -Force\""
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "koffi": "^3.1.2"
  },
  "devDependencies": {
    "electron": "^29.2.0",
    "electron-builder": "^24.13.3"
  }
}
